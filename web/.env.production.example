# ==============================================================================
# CHOUDHURY POS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Port (Google Cloud Run automatically sets PORT=8080)
PORT=8080

# Environment mode
NODE_ENV=production

# Cryptographic token signing secret (Change to a unique random 64-char string)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# Path to SQLite Central Database (Ensure this is on a persistent volume mount)
DB_PATH=/app/data/pos_central.db

# Public Server Domain / Origin (Optional, for CORS restrictions in enterprise environments)
ALLOWED_ORIGINS=*
